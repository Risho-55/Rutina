      - name: Instalar Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Instalar Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Compilar APK
        working-directory: proyecto
        run: gradle assembleRelease -Pvc=${{ github.run_number }} --no-daemon --stacktrace

      - name: Nombrar APK
        run: cp proyecto/app/build/outputs/apk/release/app-release.apk Mi-rutina-diaria-1.${{ github.run_number }}.apk

      - name: Guardar APK
        uses: actions/upload-artifact@v4
        with:
          name: Mi-rutina-diaria
          path: Mi-rutina-diaria-*.apk

      - name: Publicar en Releases
        continue-on-error: true
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v1.${{ github.run_number }}
          name: Mi rutina diaria 1.${{ github.run_number }}
          files: Mi-rutina-diaria-*.apk
